# Configuration File
# Generated by Ansible deployment

# HTTP Server Configuration
server:
  host: "0.0.0.0"
  port: 9015

# Remote Server Configuration
remote:
  url: "http://10.11.5.52:8082"
  timeout: "30s"
  retry_times: 3
  heartbeat_interval: "10s"

# Robot Configuration
robot:
  name: "{{ robot_name | default('S1_1') }}"  # Robot name (sent to server during registration)
  sn: "{{ robot_sn | string | default('10000001') }}"   # Robot serial number (sent to server during registration)
  ip: "{{ robot_ip | default(ansible_host) }}"          # Robot IP address (use remote host IP)
  trans_data_path: "/mnt/disk/trans"     # Path for transformed data (hdf5_output_<task_name>)
  original_data_path: "/mnt/disk"        # Path for original data (<task_name>/<task_name>_episode_abs_<id>.hdf5)

# Database Configuration
database:
  type: "sqlite"
  path: "./data/record_task.db"
  max_open_conns: 10
  busy_timeout: 5000  # milliseconds
  cache_size: 2000    # pages
  journal_mode: "WAL" # Write-Ahead Logging

# Storage Configuration
storage:
  data_dir: "./data/"
  max_size: "50GB"
  auto_cleanup: true
  retention_days: 30

# Log Configuration
log:
  level: "info"  # debug / info / warn / error
  file: "./log/app.log"
  max_size: "100MB"
  max_backups: 30
  max_age: 30

# Web Static Files Configuration
web:
  dist_dir: "./dist"

# Robot Web Server Configuration
robot_web_server:
  ip: "192.168.0.10"  # Robot web server IP address
  port: 5141        # Robot web server port

